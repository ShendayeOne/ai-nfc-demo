<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_md"
    android:background="@drawable/bg_result_url_content"
    android:padding="@dimen/space_md"
    android:orientation="vertical">

    <TextView
        style="@style/Widget.AiNfcDemo.ResultLabel"
        android:text="@string/result_label_url_content"
        android:textColor="@color/result_url_label"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_result_url_content"
        style="@style/Widget.AiNfcDemo.ResultValue"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/result_url_value"
        android:textIsSelectable="true"
        android:textSize="16sp" />
</LinearLayout>
