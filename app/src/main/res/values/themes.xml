<resources>
    <style name="Base.Theme.AiNfcDemo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.AiNfcDemo" parent="Base.Theme.AiNfcDemo" />
    <style name="Widget.AiNfcDemo.ActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconTint">@color/primary</item>
    </style>
    <style name="Widget.AiNfcDemo.PrimaryActionButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="Widget.AiNfcDemo.ResultLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>
    <style name="Widget.AiNfcDemo.ResultValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:text">@string/result_placeholder</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
</resources>
